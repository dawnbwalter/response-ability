{#- Search-engine and social-sharing tags for every page -#}
{%- set desc = description or lede or excerpt or site.description -%}
{%- set pageTitle = (title + " | Response-ability") if (title and page.url != "/") else "Response-ability: socially-responsible tech, from anthropology to AI" -%}
{%- set absUrl = site.url + page.url -%}
{%- set shareImage = site.url + (image or "/assets/img/social-card.png") -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ absUrl }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">{% endif %}
<meta property="og:site_name" content="Response-ability">
<meta property="og:locale" content="en_GB">
<meta property="og:type" content="{{ 'article' if kind else 'website' }}">
<meta property="og:title" content="{{ title or 'Response-ability' }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ absUrl }}">
<meta property="og:image" content="{{ shareImage }}">
{% if kind %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or 'Response-ability' }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ shareImage }}">
<link rel="alternate" type="application/rss+xml" title="Response-ability" href="/feed.xml">
{%- set org = {"@type": "Organization", "@id": site.url + "/#organization", "name": "Response-ability", "alternateName": ["Response-ability Summit", "Anthropology + Technology Conference"], "url": site.url + "/", "logo": site.url + "/favicon.png", "founder": {"@type": "Person", "name": "Dawn Walter"} } -%}
{%- set webSite = {"@type": "WebSite", "@id": site.url + "/#website", "name": "Response-ability", "url": site.url + "/", "inLanguage": "en-GB", "publisher": {"@id": site.url + "/#organization"}, "potentialAction": {"@type": "SearchAction", "target": site.url + "/search/?q={search_term_string}", "query-input": "required name=search_term_string"} } -%}
{%- set crumbs = {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"}]} -%}
{%- set graph = [org, webSite] -%}
{%- if kind -%}
  {%- set sectionUrl = {"podcast":"/podcast/","interview":"/news/","article":"/news/","news":"/news/","talk":"/talks/","speaker":"/speakers/","workshop":"/workshops/"}[kind] -%}
  {%- set sectionName = {"podcast":"Podcast","interview":"Interviews and articles","article":"Interviews and articles","news":"Interviews and articles","talk":"Talks","speaker":"Speakers","workshop":"Workshops"}[kind] -%}
  {%- set crumbs = {"@type": "BreadcrumbList", "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
    {"@type": "ListItem", "position": 2, "name": sectionName, "item": site.url + sectionUrl},
    {"@type": "ListItem", "position": 3, "name": title, "item": absUrl}]} -%}
  {%- if kind == "podcast" -%}
    {%- set main = {"@type": "PodcastEpisode", "@id": absUrl + "#episode", "url": absUrl, "name": title, "description": desc, "datePublished": (date | isoDate), "episodeNumber": episode, "image": shareImage, "inLanguage": "en-GB",
      "partOfSeries": {"@type": "PodcastSeries", "name": "Response-ability.tech podcast", "url": site.url + "/podcast/"},
      "publisher": {"@id": site.url + "/#organization"} } -%}
  {%- elif kind == "speaker" -%}
    {%- set main = {"@type": "ProfilePage", "@id": absUrl, "url": absUrl, "name": title, "description": desc, "mainEntity": {"@type": "Person", "name": title, "image": shareImage, "url": absUrl} } -%}
  {%- else -%}
    {%- set main = {"@type": "Article", "@id": absUrl + "#article", "headline": title, "description": desc, "datePublished": (date | isoDate), "image": shareImage, "url": absUrl, "mainEntityOfPage": absUrl, "inLanguage": "en-GB",
      "author": {"@id": site.url + "/#organization"}, "publisher": {"@id": site.url + "/#organization"} } -%}
  {%- endif -%}
  {%- set _ = graph.push(main) -%}
  {%- if videos and videos.length -%}
    {%- for v in videos -%}
      {%- set _ = graph.push({"@type": "VideoObject", "name": v.name or title, "description": desc, "thumbnailUrl": shareImage, "uploadDate": (date | isoDate), "embedUrl": v.embed, "url": absUrl}) -%}
    {%- endfor -%}
  {%- endif -%}
{%- elif event -%}
  {%- set _ = graph.push(event) -%}
{%- endif -%}
{%- if page.url != "/" -%}{%- set _ = graph.push(crumbs) -%}{%- endif %}
<script type="application/ld+json">{{ ({"@context": "https://schema.org", "@graph": graph}) | dump | safe }}</script>
