<article class="card">
  <a class="card-link" href="{{ item.url }}">
    {% if item.data.image %}<img src="{{ item.data.image }}" alt="" loading="lazy">{% else %}<div class="card-ph" aria-hidden="true">#</div>{% endif %}
    <p class="card-meta">{{ item.data.kindLabel }}, {{ item.data.date | monthYear }}</p>
    <h3>{{ item.data.shortTitle or item.data.title }}</h3>
  </a>
</article>
