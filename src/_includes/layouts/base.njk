<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "partials/seo.njk" %}
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css?v={{ build }}">
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Response-ability home">Response<span class="hash">#</span>ability</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      {% for item in site.nav %}<a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    </nav>
    <a class="search-link" href="/search/">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Search
    </a>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap foot">
    <div>
      <div class="wordmark wordmark-lg">Response<span class="hash">#</span>ability</div>
      <p>Founded and organised by Dawn Walter. Formerly the Anthropology + Technology Conference.</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul><li><a href="/podcast/">Podcast</a></li><li><a href="/news/">Interviews &amp; articles</a></li><li><a href="/talks/">Talks</a></li><li><a href="/workshops/">Workshops</a></li><li><a href="/speakers/">Speakers</a></li></ul>
    </div>
    <div>
      <h2>Summits</h2>
      <ul><li><a href="/2021-conference/">2021 Summit</a></li><li><a href="/2020-conference/">2020 Conference</a></li><li><a href="/2019-socially-responsible-ai/">2019 Conference</a></li></ul>
    </div>
    <div>
      <h2>About</h2>
      <ul><li><a href="/about/">About us</a></li><li><a href="/about/code-of-conduct/">Code of conduct</a></li><li><a href="/search/">Search</a></li></ul>
    </div>
  </div>
  <div class="wrap"><p class="copy">© 2019–2022 Dawn Walter</p></div>
</footer>
<script src="/assets/js/site.js?v={{ build }}" defer></script>
</body>
</html>
